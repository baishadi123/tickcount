<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the first frame, matching the page's warm paper. -->
    <color name="window_background">#FFF7F5F0</color>
    <!-- The launcher icon's backdrop, sampled off the artwork's own paper by
      .tools/图标生成/IconGen.java — keep in step with its printed value. -->
    <color name="ic_launcher_background">#F9F4EE</color>

    <!--
      The home-screen widget. These repeat the theme's card and ink values because a widget
      is inflated by the launcher, outside this app's MaterialTheme, so it cannot read them
      from there. Keep in step with ui/theme/Schemes.kt.

      Both palettes are spelled out rather than left to values-night, because the widget can
      be told to ignore the device's night setting: the light panel has to stay readable on
      a dark device, and the dark one on a light device. ui/widget/WidgetSupport.kt picks
      one at draw time. The unprefixed names below are what the layout and the picker's
      preview start from, and they follow the device as they always have.
    -->
    <!-- The panel itself is drawn at 80% (the app's own GlassAlpha), so the
     wallpaper shows through the widget the way the app's picture shows
     through its cards. -->
<!-- The values below are the same numbers as PaperSurfaces / DarkSurfaces in
     ui/theme/Schemes.kt — the widget cannot run Compose, so the palette is
     spelled out twice, and these must move together with it. The outline is
     outlineVariant there, the one the app's own card hairlines use. -->
<color name="widget_light_background">#CCFFFFFF</color>
<color name="widget_light_outline">#FFEFEBE2</color>
<color name="widget_light_text_primary">#FF1C1B18</color>
<color name="widget_light_text_secondary">#FF6F6A60</color>
<color name="widget_dark_background">#CC1D1C19</color>
<color name="widget_dark_outline">#FF2A2622</color>
    <color name="widget_dark_text_primary">#FFF3F1EA</color>
    <color name="widget_dark_text_secondary">#FFA8A296</color>

    <color name="widget_background">@color/widget_light_background</color>
    <color name="widget_outline">@color/widget_light_outline</color>
    <color name="widget_text_primary">@color/widget_light_text_primary</color>
    <color name="widget_text_secondary">@color/widget_light_text_secondary</color>
</resources>
